#include <xc.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include "cabzon.h"
#include "LCD.h"
#include "teclado.h"
#include "LM35.h"
#include "LDR.h"
#include "FC28.h"

#define _XTAL_FREQ 4000000UL

// Prototipos
void configuro(void);
void configuro_adc_lm35(void);
void configuro_adc_ldr(void);
void configuro_adc_fc28(void);
void actualiza_LCD(const char *linea1, const char *linea2);

// Variables globales
char buffer[16];
char estado_actual[32] = "";

void main(void) {
    configuro(); // Configuración inicial
    LCD_INIT();
    teclado_init();

    char tecla = 0; // Variable para guardar la tecla presionada

    while (1) {
        // Mostrar el menú principal si no hay estado previo
        if (strlen(estado_actual) == 0 || strcmp(estado_actual, "menu") == 0) {
            actualiza_LCD("1.Temp  2.Humedad", "3.Luz   4.Config");
            strcpy(estado_actual, "menu");
        }

        tecla = teclado_getc(); // Leer tecla

        if (tecla != 0) { // Si se presionó una tecla
            switch (tecla) {
                case '1': { // Actualizar y mostrar temperatura en tiempo real
                    strcpy(estado_actual, "temp");
                    while (1) {
                        configuro_adc_lm35(); // Configurar ADC para LM35
                        float temperatura = LM35_getTemperature();
                        sprintf(buffer, "%.1f C", temperatura);
                        actualiza_LCD("Temperatura:", buffer);
                        __delay_ms(500); // Actualizar cada 500 ms

                        tecla = teclado_getc();
                        if (tecla == '*') { // Regresar al menú principal
                            strcpy(estado_actual, "menu");
                            break;
                        }
                    }
                    break;
                }

                case '2': { // Actualizar y mostrar humedad en tiempo real
                    strcpy(estado_actual, "humedad");
                    while (1) {
                        configuro_adc_fc28(); // Configurar ADC para FC-28
                        uint16_t fc28_adc_valor = FC28_readADC();
                        int humedad = FC28_getMoisturePercentage(fc28_adc_valor);
                        sprintf(buffer, "%d%%", humedad);
                        actualiza_LCD("Humedad:", buffer);
                        __delay_ms(500); // Actualizar cada 500 ms

                        tecla = teclado_getc();
                        if (tecla == '*') { // Regresar al menú principal
                            strcpy(estado_actual, "menu");
                            break;
                        }
                    }
                    break;
                }

                case '3': { // Actualizar y mostrar luz en tiempo real
                    strcpy(estado_actual, "luz");
                    while (1) {
                        configuro_adc_ldr(); // Configurar ADC para LDR
                        captura_ADC(); // Leer ADC
                        unsigned char ldr_adc_valor = ADRESH;
                        int ldr_porcentaje = convierte_a_porcentaje(ldr_adc_valor);
                        sprintf(buffer, "%d%%", ldr_porcentaje);
                        actualiza_LCD("Luz:", buffer);
                        __delay_ms(500); // Actualizar cada 500 ms

                        tecla = teclado_getc();
                        if (tecla == '*') { // Regresar al menú principal
                            strcpy(estado_actual, "menu");
                            break;
                        }
                    }
                    break;
                }

                case '*': // Regresar al menú principal
                    actualiza_LCD("1.Temp  2.Humedad", "3.Luz   4.Config");
                    strcpy(estado_actual, "menu");
                    break;

                default: // Opción inválida
                    actualiza_LCD("Opcion invalida", "");
                    __delay_ms(1000);
                    strcpy(estado_actual, "menu");
                    break;
            }
        }
        __delay_ms(100); // Reducir la frecuencia de actualización si no hay entrada
    }
}

void configuro(void) {
    OSCCON1 = 0x60;  // HFINTOSC
    OSCFRQ = 0x02;   // HFINTOSC a 4MHz
    OSCEN = 0x40;    // Habilitar HFINTOSC
    
    // Configuración de pines
    TRISB = 0xF0;    // RB4-RB7 (columnas) como entrada, RB0-RB3 (filas) como salida
    ANSELB = 0x00;   // Puerto B como digital
    WPUB = 0xF0;     // Pull-up habilitados para las columnas
    TRISD = 0x00;    // Puerto D como salida
    ANSELD = 0x00;   // Puerto D como digital
    LATD = 0x00;     // Apagar todas las salidas en el puerto D
}

void configuro_adc_lm35(void) {
    ADCON0bits.ADFM = 1;   // Justificación a la derecha
    ADCON0bits.CS = 1;     // Fuente de reloj interno (ADCRC)
    ADPCH = 0x00;          // Canal RA0 (AN0)
    ADCON2 = 0x00;         // Sin promedio
    ADCON0bits.ADON = 1;   // Habilitar ADC
}

void configuro_adc_ldr(void) {
    ADCON0bits.ADFM = 0;   // Justificación a la izquierda
    ADCON0bits.CS = 1;     // Fuente de reloj interno (ADCRC)
    ADPCH = 0x01;          // Canal RA1 (AN1)
    ADCON2 = 0x62;         // CRS = 6 (modo promedio)
    ADRPT = 64;            // Número de repeticiones
    ADCON0bits.ADON = 1;   // Habilitar ADC
}

void configuro_adc_fc28(void) {
    ADCON0bits.ADFM = 1;   // Justificación a la derecha
    ADCON0bits.CS = 1;     // Fuente de reloj interno (ADCRC)
    ADPCH = 0x02;          // Canal RA2 (AN2)
    ADCON2 = 0x00;         // Sin promedio
    ADCON0bits.ADON = 1;   // Habilitar ADC
}

void actualiza_LCD(const char *linea1, const char *linea2) {
    BORRAR_LCD();
    POS_CURSOR(1, 0);
    ESCRIBE_MENSAJE(linea1, strlen(linea1));
    POS_CURSOR(2, 0);
    ESCRIBE_MENSAJE(linea2, strlen(linea2));
}
