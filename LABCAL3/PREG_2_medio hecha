#include "cabecera.h"
#include "LCD.h"
#include "LIB_UART.h"
#include <stdlib.h>
#include <stdio.h>
#define _XTAL_FREQ 16000000UL

void configuro();
void LCD_init();
void UART_init();
unsigned int lectura_ADC_0(void);
unsigned int lectura_ADC_1(void);
void mostrar_parametros();

float convertir_temperatura(float voltaje);
float convertir_velocidad_aire(float voltaje);

float convertir_temperatura(float voltaje) {
    return (7.33 * voltaje) + 5.54; // Fórmula ajustada para temperatura
}

float convertir_velocidad_aire(float voltaje) {
    return (1.50 * voltaje) - 0.22; // Fórmula ajustada para velocidad del aire
}

void main(void) {
    configuro();
    LCD_init();
    UART_init();  // Inicializar UART

    while(1) {
        mostrar_parametros();
        __delay_ms(1000);
    }
}

void mostrar_parametros() {
    char buffer[16];

    // Lectura y conversión de valores
    float voltaje = lectura_ADC_0() * 5.0 / 4096.0;  // Voltaje en RF0
    float temp = convertir_temperatura(voltaje);      // Conversión de voltaje a temperatura
    float velocidad_aire = convertir_velocidad_aire(lectura_ADC_1() * 5.0 / 4096.0);  // Velocidad de aire en RF1

    // Mostrar valores en el LCD para verificar
    POS_CURSOR(1, 0);
    sprintf(buffer, "V: %.2f T: %.1f", voltaje, temp);
    ESCRIBE_MENSAJE(buffer, 16);

    POS_CURSOR(2, 0);
    sprintf(buffer, "Vv: %.1f m/s", velocidad_aire);
    ESCRIBE_MENSAJE(buffer, 16);

    // Diagnóstico: Prueba de condición simplificada para encender RB0
    if (voltaje >= 3.3 && voltaje <= 4.6) {  // Solo usando el rango de voltaje como prueba
        LATBbits.LATB0 = 1;  // Enciende LED de apertura en RB0
        LATBbits.LATB1 = 0;  // Apaga LED de cierre en RB1
        __delay_ms(5000);    // Mantener LED de apertura encendido por 5 segundos
        LATBbits.LATB0 = 0;  // Apagar LED de apertura
    } else {
        LATBbits.LATB0 = 0;  // Apaga LED de apertura en RB0
        LATBbits.LATB1 = 1;  // Enciende LED de cierre en RB1
        __delay_ms(3000);    // Mantener LED de cierre encendido por 3 segundos
        LATBbits.LATB1 = 0;  // Apagar LED de cierre
    }

    // Enviar al UART para verificar
    U1_STRING_SEND("Parametros del Invernadero:");
    U1_NEWLINE();
    sprintf(buffer, "Voltaje: %.2f V", voltaje);
    U1_STRING_SEND(buffer);
    U1_NEWLINE();
    sprintf(buffer, "Temp: %.1f C", temp);
    U1_STRING_SEND(buffer);
    U1_NEWLINE();
    sprintf(buffer, "Velocidad Aire: %.1f m/s", velocidad_aire);
    U1_STRING_SEND(buffer);
    U1_NEWLINE();
}

unsigned int lectura_ADC_0(void) {
    ADPCH = 0B101000;           // Selecciona AN0 RF0
    ADCON0bits.GO = 1;          // Inicia la conversión
    while(ADCON0bits.GO);       // Espera a que termine la conversión
    return ((ADRESH << 8) + ADRESL); // Retorna el valor del ADC
}

unsigned int lectura_ADC_1(void) {
    ADPCH = 0B101001;           // Selecciona AN1 RF1
    ADCON0bits.GO = 1;          // Inicia la conversión
    while(ADCON0bits.GO);       // Espera a que termine la conversión
    return ((ADRESH << 8) + ADRESL); // Retorna el valor del ADC
}

void configuro() {
    OSCCON1 = 0x60;             // HFINTOSC
    OSCFRQ  = 0x05;             // HFINTOSC a 16 MHz
    OSCEN   = 0x40;             // Habilitar HFINTOSC
    
    // Configuración ADC
    TRISF  = 0x03;              // RF1:RF0 entrada
    ANSELF = 0x03;              // RF1:RF0 analógico
    ADCON0 = 0x94;              // Configuración del ADCON0

    // Configuración del LCD
    TRISD = 0x00;
    ANSELD = 0x00;

    // Configuración de LEDs en RB0 y RB1 como salidas
    TRISBbits.TRISB0 = 0;       // Configurar RB0 como salida
    TRISBbits.TRISB1 = 0;       // Configurar RB1 como salida
    LATBbits.LATB0 = 0;         // Inicialmente apagado
    LATBbits.LATB1 = 0;         // Inicialmente apagado
}

void LCD_init() {
    __delay_ms(29);
    LCD_CONFIG();
    BORRAR_LCD();
    CURSOR_HOME();
    CURSOR_ONOFF(OFF);
}

void UART_init() {
    U1_INIT(103);  // Configuración del UART a 9600 baudios
}
