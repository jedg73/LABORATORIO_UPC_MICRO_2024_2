#include <stdlib.h>
#include <stdio.h>
#include <pic18f57q43.h>
#include <xc.h>
#include "cabecera.h"
#include "LCD.h"
#define _XTAL_FREQ 4000000UL

unsigned char logo1[]={0x00, 0x00, 0x00, 0x00, 0x10, 0x10, 0x10, 0x1C};
unsigned char logo2[]={0x03, 0x05, 0x07, 0x07, 0x07, 0x07, 0x0F, 0x1F};
unsigned char logo3[]={0x1E, 0x1F, 0x1F, 0x1F, 0x10, 0x1F, 0x10, 0x10};
unsigned char logo4[]={0x1D, 0x1F, 0x0F, 0x07, 0x03, 0x00, 0x00, 0x00};
unsigned char logo5[]={0x1F, 0x1F, 0x1F, 0x1F, 0x1B, 0x12, 0x12, 0x1B};
unsigned char logo6[]={0x1C, 0x14, 0x10, 0x10, 0x00, 0x00, 0x00, 0x00};

void configuro()
{
    OSCCON1 = 0x60;
    OSCFRQ = 0x08;
    OSCEN = 0x40;
    TRISD = 0x00;
    ANSELD = 0x00;
}

void LCD_init()
{
    __delay_ms(29);
    LCD_CONFIG();
    BORRAR_LCD();
    CURSOR_HOME();
    CURSOR_ONOFF(OFF);
}

void main(void)
{
    configuro();
    LCD_init();
    GENERACARACTER(logo1,0);
    GENERACARACTER(logo2,1);
    GENERACARACTER(logo3,2);
    GENERACARACTER(logo4,3);
    GENERACARACTER(logo5,4);
    GENERACARACTER(logo6,5);
    while(1)
    {
        POS_CURSOR(1,1);
        ENVIA_CHAR(0x00);
        ENVIA_CHAR(0x01);
        ENVIA_CHAR(0x02);
        POS_CURSOR(2,1);
        ENVIA_CHAR(0x03);
        ENVIA_CHAR(0x04);
        ENVIA_CHAR(0x05);

        POS_CURSOR(1,12);
        ENVIA_CHAR(0x00);
        ENVIA_CHAR(0x01);
        ENVIA_CHAR(0x02);
        POS_CURSOR(2,12);
        ENVIA_CHAR(0x03);
        ENVIA_CHAR(0x04);
        ENVIA_CHAR(0x05);

    }
}
